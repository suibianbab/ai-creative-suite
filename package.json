{
  "name": "ai-creative-suite",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev": "pnpm --filter @acs/shared build && pnpm --filter @acs/image-document build && pnpm -r --parallel --filter @acs/api --filter @acs/web dev",
    "build": "pnpm --filter @acs/shared build && pnpm --filter @acs/image-document build && pnpm --filter @acs/api build && pnpm --filter @acs/web build",
    "typecheck": "pnpm --filter @acs/shared build && pnpm --filter @acs/image-document build && pnpm -r typecheck",
    "test": "pnpm --filter @acs/image-document build && pnpm --filter @acs/image-document test",
    "lint": "biome check .",
    "format": "biome format --write .",
    "qa:validate": "node scripts/qa/run-regression.mjs validate",
    "qa:smoke": "node scripts/qa/run-regression.mjs smoke",
    "qa:integration": "node scripts/qa/run-regression.mjs integration",
    "qa:oidc": "node scripts/qa/run-regression.mjs oidc",
    "qa:image": "node scripts/qa/run-regression.mjs image-qa",
    "qa:live-model": "node scripts/qa/run-regression.mjs live-model",
    "qa:grounding": "node scripts/qa/run-regression.mjs live-grounding",
    "qa:browser-image": "node scripts/qa/run-regression.mjs browser-image",
    "dev:photocraft-bridge": "node scripts/photocraft/dev-bridge.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.0",
    "playwright-core": "1.64.1",
    "typescript": "^5.9.3"
  }
}
