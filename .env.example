# Copy to .env for local infrastructure. Never commit real credentials.
DATABASE_URL=postgresql://acs:acs_local_only@localhost:5432/acs?schema=public
REDIS_URL=redis://localhost:6379
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=acs-local
S3_ACCESS_KEY=acs_local
S3_SECRET_KEY=acs_local_only
API_PORT=4000
API_HOST=127.0.0.1
WEB_ORIGIN=http://localhost:3000
# Optional development browser project routes. Provision locally; production JWKS requires HTTPS.
AUTH_ISSUER=http://localhost:8180/realms/acs-dev
AUTH_AUDIENCE=acs-api
AUTH_JWKS_URL=http://localhost:8180/realms/acs-dev/protocol/openid-connect/certs
AUTH_ALLOW_INSECURE_LOOPBACK=true
