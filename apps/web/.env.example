NEXT_PUBLIC_AUTH_ISSUER=http://localhost:8180/realms/acs-dev
NEXT_PUBLIC_AUTH_CLIENT_ID=acs-dev-web
NEXT_PUBLIC_API_ORIGIN=http://localhost:4000
NEXT_PUBLIC_WORKSPACE_ID=replace-with-provisioned-workspace-uuid
# Optional local development only. Never enable the unauthenticated route in a public deployment.
# IMAGE_BACKGROUND_PROVIDER=openai
# IMAGE_BACKGROUND_MODEL=gpt-image-2.5-flare
# IMAGE_LOCAL_EDIT_PROVIDER=qwen
# IMAGE_LOCAL_EDIT_MODEL=qwen-image-2.0-pro
# DASHSCOPE_API_KEY=server-side-secret
# Optional for a region/workspace-specific Model Studio endpoint:
# DASHSCOPE_IMAGE_ENDPOINT=https://your-workspace.cn-beijing.maas.aliyuncs.com/api/v1/services/aigc/multimodal-generation/generation
# Alternative provider: IMAGE_LOCAL_EDIT_PROVIDER=openai, IMAGE_LOCAL_EDIT_MODEL=gpt-image-1.5
# OPENAI_API_KEY=server-side-secret
